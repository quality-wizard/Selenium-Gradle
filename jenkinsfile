pipeline {
    agent any

    tools {
        nodejs 'Node'   // Nombre configurado en Jenkins Global Tool Configuration
        allure 'Allure' // Nombre configurado para Allure CLI
    }

    environment {
        XRAY_CLIENT_ID     = credentials('xray-client-id')
        XRAY_CLIENT_SECRET = credentials('xray_client_secret')
        JIRA_EMAIL         = credentials('jira_email')
        JIRA_API_TOKEN     = credentials('jira_api_token')
        JIRA_URL           = credentials('jira_url')
    }

    options {
        timestamps()
    }

    stages {

        stage('Check Node.js availability') {
            steps {
                echo 'Verificando PATH y versión de Node.js...'
                sh 'echo $PATH'
                sh 'which node || echo "node no encontrado"'
                sh 'node -v || echo "node no ejecutable"'

                script {
                    def nodeHome = tool 'Node'
                    echo "Ruta de Node.js configurada: ${nodeHome}"
                    sh "${nodeHome}/bin/node -v"
                }
            }
        }

        stage('Build & Test') {
            steps {
                echo 'Ejecutando pruebas con Gradle...'
                sh '''
                    # Copiar historial si existe
                    if [ -d build/allure-results/history ]; then
                        echo "Copiando historial Allure..."
                        mkdir -p tmp/allure-history
                        cp -r build/allure-results/history/* tmp/allure-history || true
                    else
                        echo "No existe historial previo de Allure. Continuando..."
                    fi
                '''
                sh './gradlew clean test'
            }
            post {
                always {
                    sh '''
                        # Restaurar historial previo si existe
                        if [ -d allure-history ]; then
                            echo "Copiando historial previo a results..."
                            mkdir -p build/allure-results/history
                            cp -r allure-history/* build/allure-results/history || true
                        else
                            echo "No hay historial previo para restaurar."
                        fi
                    '''
                    sh './gradlew clean test'

                    sh '''
                        # Guardar historial generado para próxima ejecución
                        if [ -d build/allure-results/history ]; then
                            echo "Guardando historial generado para la próxima ejecución..."
                            mkdir -p allure-history
                            cp -r build/allure-results/history/* allure-history || true
                        fi
                    '''
                    allure includeProperties: false, jdk: '', results: [[path: 'build/allure-results']]
                    echo 'Subiendo resultados a Xray...'
                    sh 'chmod +x ./upload-xray.sh && ./upload-xray.sh'
                    echo 'Generando PDF con Puppeteer...'
                    sh '''
                        if ! command -v node >/dev/null 2>&1; then
                            echo "Node.js no está instalado. Abortando."
                            exit 1
                        fi
                        chmod +x ./generate-and-upload-pdf.sh
                        ./generate-and-upload-pdf.sh
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline ejecutado correctamente.'
        }
        failure {
            echo 'La ejecución del pipeline falló.'
        }
    }
}